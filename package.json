{
  "name": "tinycode-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run tests/core.test.ts tests/tools.test.ts",
    "test:runtime": "vitest run tests/runtime.test.ts",
    "test:e2e": "playwright test",
    "demo": "tsx scripts/demo.ts",
    "eval": "tsx scripts/evaluate.ts",
    "agent": "tsx src/cli.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.0.0",
    "electron-vite": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
